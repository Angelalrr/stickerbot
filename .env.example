# Puerto donde escucha Express (Render inyecta PORT automaticamente)
PORT=3000

# Base de datos gratuita externa (MongoDB Atlas Free M0) para persistir cuentas,
# grupos autorizados y credenciales de WhatsApp entre reinicios de Render.
# Si se deja vacio, se usa almacenamiento local temporal en la carpeta data/.
MONGODB_URI=

# Configuracion general de StickerBot
BOT_NAME=StickerBot
STICKER_PACK=StickerBot Pack
STICKER_AUTHOR=StickerBot

# Limites seguros recomendados para Render Free (512 MB RAM)
MAX_IMAGE_MB=10
MAX_VIDEO_MB=20
# Duracion maxima de stickers animados de WhatsApp (10 segundos)
MAX_VIDEO_SECONDS=10
MAX_STICKER_KB=500
AUDIO_KBPS=32
AUDIO_LEAD_MS=100
LOG_LEVEL=info

# URL opcional del bench downloader (vacía por defecto).
# Si se configura, usar POST /download {url, format} -> GET /file/<job_id>/<index> como respaldo.
BENCH_DOWNLOADER_URL=
